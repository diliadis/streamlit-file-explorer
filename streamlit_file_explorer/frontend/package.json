{
  "name": "streamlit_file_explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run typecheck && npm run build:frontend:production",
    "build:frontend:production": "cross-env NODE_ENV=production vite build",
    "clean": "rimraf build",
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "format": "prettier --write src vite.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts"
  },
  "prettier": {},
  "dependencies": {
    "@streamlit/component-v2-lib": "^0.2.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.10",
    "vitest": "^5.0.5"
  }
}
